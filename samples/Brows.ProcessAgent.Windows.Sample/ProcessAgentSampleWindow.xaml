<Window x:Class="Brows.ProcessAgentSampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:brows="http://schemas.brows.app/winfx/2026/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProcessAgent sample"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="620"
        Closing="ProcessAgentSampleWindow_Closing">
  <Grid Margin="12" IsSharedSizeScope="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0 0 0 4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0" Target="{Binding ElementName=WorkingDirectoryTextBox}">Working directory</Label>
      <TextBox x:Name="WorkingDirectoryTextBox" Grid.Column="1"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0 0 0 4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0" Target="{Binding ElementName=FileNameTextBox}">Executable</Label>
      <TextBox x:Name="FileNameTextBox" Grid.Column="1"/>
    </Grid>
    <Grid Grid.Row="2" Margin="0 0 0 4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="Label"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0" Target="{Binding ElementName=ArgumentsTextBox}">Arguments</Label>
      <TextBox x:Name="ArgumentsTextBox" Grid.Column="1"/>
    </Grid>
    <StackPanel Grid.Row="3"
                Orientation="Horizontal"
                Margin="0 4 0 8">
      <Button x:Name="RunButton"
              Content="_Run"
              Width="80"
              Margin="0 0 8 0"
              IsDefault="True"
              Click="RunButton_Click"/>
      <Button x:Name="CancelButton"
              Content="_Cancel"
              Width="80"
              IsEnabled="False"
              Click="CancelButton_Click"/>
      <TextBlock x:Name="StatusTextBlock"
                 Margin="12 0 0 0"
                 VerticalAlignment="Center"
                 Text="Ready."/>
    </StackPanel>
    <brows:ProcessProxyView x:Name="ProcessProxyView"
                            Grid.Row="4"
                            Background="Black"
                            Foreground="White"
                            FontFamily="Consolas">
      <brows:ProcessProxyView.Style>
        <Style TargetType="brows:ProcessProxyView">
          <Setter Property="ProcessDateTimeFormat" Value="HH:mm:ss"/>
          <Setter Property="ProcessStandardErrorLineStyle">
            <Setter.Value>
              <Style>
                <Setter Property="TextBlock.Foreground" Value="Yellow"/>
              </Style>
            </Setter.Value>
          </Setter>
          <Setter Property="ProcessBorderStyle">
            <Setter.Value>
              <Style TargetType="Border">
                <Setter Property="Background" Value="DarkSlateGray"/>
                <Style.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="Padding" Value="5 2.5"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                  </Style>
                </Style.Resources>
              </Style>
            </Setter.Value>
          </Setter>
        </Style>
      </brows:ProcessProxyView.Style>
    </brows:ProcessProxyView>
  </Grid>
</Window>
